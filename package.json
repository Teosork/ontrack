{
  "name": "ontrack",
  "version": "0.1.0",
  "private": true,
  "description": "Nutrition tracking web app — calories, protein, carbs, fat.",
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
